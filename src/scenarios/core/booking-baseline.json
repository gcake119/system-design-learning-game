{
  "schemaVersion": "1.1",
  "id": "booking-baseline",
  "version": "1.0.0",
  "title": "熱門活動訂票系統",
  "difficulty": "Medium",
  "summary": "設計一套能承受開賣尖峰、避免超賣並提供可追蹤失敗處理的訂票系統。",
  "learningObjectives": [
    "辨識流量尖峰下的入口保護策略",
    "用鎖定與逾時機制避免同一座位重複售出",
    "區分同步購票路徑與非同步通知工作"
  ],
  "successCriteria": [
    "入口具備流量保護且核心服務可水平擴充",
    "座位與訂單由具備交易能力的持久化儲存負責",
    "通知工作位於非同步路徑"
  ],
  "requirements": {
    "readsPerSec": 50000,
    "writesPerSec": 5000,
    "storageGB": 2000,
    "latencyMs": 300,
    "users": "5M MAU"
  },
  "constraints": [
    "同一座位不可售予兩位使用者",
    "付款逾時後必須釋放座位",
    "通知失敗不可回滾已完成的訂單"
  ],
  "hints": [
    {
      "title": "先保護入口",
      "content": "思考速率限制與等候室如何降低後端瞬間負載。"
    },
    {
      "title": "找出一致性邊界",
      "content": "座位保留需要明確的唯一寫入者、鎖定期限與冪等鍵。"
    }
  ],
  "tags": ["booking", "traffic-spike", "consistency", "idempotency"],
  "architecture": {
    "components": [
      { "id": "gateway", "componentId": "api-gateway", "x": 80, "y": 140 },
      { "id": "limiter", "componentId": "rate-limiter", "x": 300, "y": 140 },
      { "id": "app", "componentId": "app-server", "x": 520, "y": 140 },
      { "id": "lock", "componentId": "distributed-lock", "x": 740, "y": 60 },
      { "id": "sql", "componentId": "sql-db", "x": 740, "y": 220 },
      { "id": "queue", "componentId": "message-queue", "x": 520, "y": 340 }
    ],
    "edges": [
      { "source": "gateway", "target": "limiter" },
      { "source": "limiter", "target": "app" },
      { "source": "app", "target": "lock" },
      { "source": "app", "target": "sql" },
      { "source": "app", "target": "queue", "async": true }
    ]
  },
  "rounds": [
    {
      "id": "normal-sale",
      "title": "一般販售",
      "trafficRps": 3000,
      "incidents": []
    },
    {
      "id": "opening-spike",
      "title": "開賣尖峰",
      "trafficRps": 50000,
      "incidents": [
        {
          "id": "flash-crowd",
          "type": "traffic-spike",
          "title": "瞬間湧入",
          "description": "廣告倒數結束後，入口流量在數秒內放大十倍。",
          "severity": 0.85,
          "affectedComponentIds": ["gateway", "limiter", "app"]
        }
      ]
    }
  ],
  "solution": {
    "summary": "入口先削峰，訂票服務在交易邊界內保留座位並建立訂單，付款與通知以冪等事件銜接。鎖只能協助協調，資料庫唯一約束與交易才是防止超賣的最後防線。",
    "keyDecisions": [
      {
        "title": "入口保護",
        "rationale": "API Gateway 與 Rate Limiter 在請求進入核心服務前限制突發流量。"
      },
      {
        "title": "交易式座位保留",
        "rationale": "使用資料庫交易、唯一約束與明確逾時狀態，避免並行請求售出同一座位。"
      },
      {
        "title": "通知非同步化",
        "rationale": "訂單提交後再透過訊息佇列寄送通知，通知失敗不回滾訂單。"
      }
    ],
    "officialReferences": [
      {
        "kind": "official-documentation",
        "publisher": "PostgreSQL",
        "title": "Transaction Isolation",
        "url": "https://www.postgresql.org/docs/current/transaction-iso.html",
        "note": "理解並行更新、鎖定與需要重試的交易。"
      },
      {
        "kind": "official-documentation",
        "publisher": "PostgreSQL",
        "title": "Constraints",
        "url": "https://www.postgresql.org/docs/current/ddl-constraints.html",
        "note": "以唯一約束保護座位與訂單的不變條件。"
      }
    ],
    "furtherReading": [
      {
        "kind": "ebook-page",
        "publisher": "ByteByteGo",
        "work": "Big Archive",
        "edition": "2025",
        "sectionTitle": "How to Design Good APIs",
        "pdfPages": [380, 381],
        "officialUrl": "https://blog.bytebytego.com/p/free-system-design-pdf-158-pages"
      }
    ]
  },
  "provenance": {
    "author": "System Design Lab contributors",
    "license": "CC-BY-SA-4.0",
    "independentlyAuthored": true,
    "sources": [
      {
        "title": "PostgreSQL: Explicit Locking",
        "url": "https://www.postgresql.org/docs/current/explicit-locking.html",
        "usage": "reference-only",
        "author": "PostgreSQL Global Development Group"
      }
    ]
  }
}
